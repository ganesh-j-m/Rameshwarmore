// Prisma schema for rameshwarmore.in
// Run `npm run db:push` (quick dev sync) or `npm run db:migrate` (versioned migrations)
// after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH ----------

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  logs         ActivityLog[]
}

model ActivityLog {
  id        String    @id @default(cuid())
  admin     AdminUser @relation(fields: [adminId], references: [id])
  adminId   String
  action    String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH
  entity    String
  entityId  String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
  @@index([adminId])
}

// ---------- CORE PROFILE ----------

model Profile {
  id               String   @id @default(cuid())
  fullName         String   @default("Rameshwar Parmeshwar More")
  designation      String   @default("Kirtankar | Speaker | Researcher | Social Contributor")
  tagline          String   @default("Connecting Tradition, Knowledge, Literature and Social Awareness.")
  heroImageUrl     String?
  aboutShort       String?  @db.Text
  aboutLong        String?  @db.Text
  email            String?
  phone            String?
  address          String?
  dateOfBirth      DateTime?
  languagesSpoken  String?  // comma separated
  yearsOfKirtan    Int      @default(10)
  metaTitle        String?
  metaDescription  String?
  updatedAt        DateTime @updatedAt
}

model SocialLink {
  id       String  @id @default(cuid())
  platform String // YouTube, Facebook, Instagram, X, LinkedIn
  url      String
  order    Int     @default(0)
  published Boolean @default(true)
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

// ---------- EDUCATION ----------

model Education {
  id           String   @id @default(cuid())
  level        String // SSC, HSC, B.A., M.A. Marathi
  institution  String
  boardOrUni   String
  year         Int
  percentage   Float
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- RESEARCH ----------

model ResearchProject {
  id          String   @id @default(cuid())
  title       String
  type        String // Dissertation, Research Discussion
  description String?  @db.Text
  year        Int?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Publication {
  id           String   @id @default(cuid())
  title        String
  journal      String
  publisher    String?
  eIssn        String?
  month        String?
  year         Int
  url          String?
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- EXPERIENCE / JOURNEY ----------

model JourneyItem {
  id          String   @id @default(cuid())
  title       String
  organization String?
  description String?  @db.Text
  startYear   Int?
  endYear     Int?
  category    String   @default("KIRTAN") // KIRTAN, EXPERIENCE, EDUCATION, MILESTONE
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- AWARDS ----------

model Award {
  id             String   @id @default(cuid())
  title          String
  organization   String
  year           Int?
  date           DateTime?
  location       String?
  description    String?  @db.Text
  certificateUrl String?
  imageUrl       String?
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------- EVENTS ----------

model Event {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  eventDate        DateTime?
  time             String?
  venue            String?
  city             String?
  organizer        String?
  description      String?  @db.Text
  posterUrl        String?
  mapsUrl          String?
  registrationUrl  String?
  contactNumber    String?
  status           String   @default("UPCOMING") // UPCOMING, COMPLETED, CANCELLED
  featured         Boolean  @default(false)
  published        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------- LECTURES / WORKSHOPS / CONFERENCES ----------

model Lecture {
  id           String   @id @default(cuid())
  title        String
  type         String   @default("LECTURE") // LECTURE, WORKSHOP, CONFERENCE, DISCUSSION
  organizer    String?
  location     String?
  description  String?  @db.Text
  year         Int?
  order        Int      @default(0)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- CERTIFICATIONS ----------

model Certification {
  id              String   @id @default(cuid())
  title           String
  issuer          String
  score           String?
  date            DateTime?
  certificateUrl  String?
  verificationUrl String?
  order           Int      @default(0)
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ---------- GALLERY ----------

model GalleryAlbum {
  id        String         @id @default(cuid())
  title     String
  category  String // Kirtan, Awards, Conferences, Lectures, Social Activities, Career Katta, Workshops, Cultural Events, Personal/Professional
  order     Int            @default(0)
  published Boolean        @default(true)
  createdAt DateTime       @default(now())
  images    GalleryImage[]
}

model GalleryImage {
  id       String       @id @default(cuid())
  album    GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId  String
  url      String
  caption  String?
  altText  String?
  featured Boolean      @default(false)
  order    Int          @default(0)
}

// ---------- VIDEOS ----------

model Video {
  id           String   @id @default(cuid())
  title        String
  youtubeUrl   String
  thumbnailUrl String?
  description  String?  @db.Text
  category     String?
  date         DateTime?
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ---------- SOCIAL WORK ----------

model SocialWork {
  id           String   @id @default(cuid())
  title        String
  date         DateTime?
  location     String?
  organization String?
  description  String?  @db.Text
  imageUrl     String?
  videoUrl     String?
  impact       String?  @db.Text
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// ---------- BLOG ----------

model Category {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model Tag {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?
  content         String     @db.Text
  coverImageUrl   String?
  category        Category?  @relation(fields: [categoryId], references: [id])
  categoryId      String?
  tags            Tag[]
  metaTitle       String?
  metaDescription String?
  published       Boolean    @default(false)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// ---------- TESTIMONIALS ----------

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  role         String?
  organization String?
  profileImage String?
  testimonial  String   @db.Text
  rating       Int?     @default(5)
  featured     Boolean  @default(false)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ---------- CONTACT / INVITATIONS ----------

model ContactInquiry {
  id               String   @id @default(cuid())
  fullName         String
  mobileNumber     String
  email            String?
  organization     String?
  programType      String?
  eventDate        DateTime?
  venue            String?
  city             String?
  expectedAudience String?
  message          String?  @db.Text
  status           String   @default("NEW") // NEW, CONTACTED, CONFIRMED, CLOSED
  ipAddress        String?
  createdAt        DateTime @default(now())
}
